generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int                   @id @default(autoincrement())
  username          String                @unique
  password          String
  role              String                @default("user")
  tipo              String                @default("Usuário")
  full_name         String?
  cpf_cnpj          String?
  telefone          String?
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro_end        String?
  cidade            String?
  estado_end        String?
  photo             String?
  created_at        DateTime              @default(now())
  default_workspace String?               @default("mapa")
  default_screen    String?               @default("mapa")
  inactivity_limit  Int?                  @default(30)
  notif_email       Boolean               @default(true)
  notif_sms         Boolean               @default(false)
  notif_push        Boolean               @default(true)
  last_active       DateTime              @default(now())
  token_version     Int                   @default(0)
  birth_date        DateTime?
  code              String?               @unique
  colorIndex        Int                   @default(0)
  assigned_state    String?
  comissao          Float?
  isVago            Int                   @default(0)
  cargo             String?
  company_name      String?
  groupId           Int?
  area_atuacao      String?
  base_logistica    String?
  email             String?
  supabase_id       String?               @unique
  userTypeId        Int?
  canVisit          Boolean               @default(false)
  bairros           Bairro[]              @relation("UserBairros")
  blocosViagem      BlocosViagem[]
  clientes          Cliente[]             @relation("UserClientes")
  visitasLogistica  DistanciasLogistica[]
  FeedComment       FeedComment[]
  FeedPost          FeedPost[]
  FeedReaction      FeedReaction[]
  historicosVisitas HistoricoVisitas[]
  planejamentos     PlanejamentoVisitas[]
  territories       Territory[]           @relation("UserTerritories")
  activities        UserActivity[]
  permissions       UserPermission[]
  notificationsSeen NotificationSeen[]
  group             Group?                @relation(fields: [groupId], references: [id])
  userType          UserType?             @relation(fields: [userTypeId], references: [id])
  managedUsers      User[]                @relation("UserManagement")
  managedBy         User[]                @relation("UserManagement")

  // Route Planning relations
  routeCycles       RouteCycle[]          @relation("SupervisorCycles")
  createdCycles     RouteCycle[]          @relation("CreatorCycles")
  routeSequences    RouteSequence[]
  auditLogs         RouteAuditLog[]
  exports           RouteExport[]

  // Data Integration relations
  createdConnections ExternalConnection[]         @relation("ConnectionCreator")
  updatedConnections ExternalConnection[]         @relation("ConnectionUpdater")
  createdDatasets    ExternalDataset[]            @relation("DatasetCreator")
  updatedDatasets    ExternalDataset[]            @relation("DatasetUpdater")
  createdJobs        EtlJob[]                     @relation("JobCreator")
  updatedJobs        EtlJob[]                     @relation("JobUpdater")
  triggeredRuns      EtlJobRun[]                  @relation("RunTriggerer")
  createdSnapshots   ClientesSnapshot[]           @relation("SnapshotCreator")
  publishedVersions  ClientesPublishedVersion[]   @relation("VersionPublisher")
  rolledBackVersions ClientesPublishedVersion[]   @relation("VersionRollbacker")
  createdOverrides   ClientesSourceOverride[]     @relation("OverrideCreator")

  @@map("users")
}

model RouteCycle {
  id                 Int                   @id @default(autoincrement())
  name               String
  start_date         DateTime
  end_date           DateTime
  status             String                @default("rascunho") // rascunho, calculando, pronto_revisao, publicado, em_execucao, finalizado, cancelado
  supervisor_user_id Int
  created_by         Int
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  supervisor         User                  @relation("SupervisorCycles", fields: [supervisor_user_id], references: [id])
  creator            User                  @relation("CreatorCycles", fields: [created_by], references: [id])
  weeks              RouteCycleWeek[]
  clientSnapshots    RouteClientSnapshot[]
  assignments        RouteAssignment[]
  sequences          RouteSequence[]
  clusters           RouteCluster[]
  blocks             RouteBlock[]
  exports            RouteExport[]

  @@index([supervisor_user_id])
  @@index([created_by])
  @@map("route_cycles")
}

model RouteCycleWeek {
  id             Int               @id @default(autoincrement())
  route_cycle_id Int
  week_number    Int               // 1 a 4
  start_date     DateTime
  end_date       DateTime
  status         String            @default("pendente")
  
  cycle          RouteCycle        @relation(fields: [route_cycle_id], references: [id], onDelete: Cascade)
  assignments    RouteAssignment[]
  sequences      RouteSequence[]
  clusters       RouteCluster[]
  blocks         RouteBlock[]

  @@map("route_cycle_weeks")
}

model RouteClientSnapshot {
  id                   Int               @id @default(autoincrement())
  route_cycle_id       Int
  client_id            Int
  owner_user_id        Int
  supervisor_user_id   Int
  client_name          String
  trade_name           String?
  cnpj                 String?
  address              String?
  city                 String?
  state                String?
  zip_code             String?
  classification       String?           // Estratégico, Forte, Médio, Pontual
  latitude             Float?
  longitude            Float?
  distance_base_km     Float?
  source_base          String?
  source_logistic_type String?

  cycle                RouteCycle        @relation(fields: [route_cycle_id], references: [id], onDelete: Cascade)
  assignments          RouteAssignment[]
  sequenceItems        RouteSequenceItem[]

  @@map("route_clients_snapshot")
}

model RouteAssignment {
  id                 Int                 @id @default(autoincrement())
  route_cycle_id     Int
  week_id            Int
  client_snapshot_id Int
  assigned_by        Int
  assigned_at        DateTime            @default(now())
  assignment_mode    String              @default("automatic") // automatic, manual
  notes              String?

  cycle              RouteCycle          @relation(fields: [route_cycle_id], references: [id], onDelete: Cascade)
  week               RouteCycleWeek      @relation(fields: [week_id], references: [id], onDelete: Cascade)
  clientSnapshot     RouteClientSnapshot @relation(fields: [client_snapshot_id], references: [id], onDelete: Cascade)

  @@map("route_assignments")
}

model RouteSequence {
  id                     Int                  @id @default(autoincrement())
  name                   String?
  route_cycle_id         Int?
  week_id                Int?
  semana                 String?
  supervisor_user_id     Int
  route_date             DateTime?
  start_lat              Float?
  start_lng              Float?
  start_label            String?
  end_lat                Float?
  end_lng                Float?
  end_label              String?
  total_distance_km      Float?
  total_duration_minutes Int?
  average_km_per_visit   Float?
  total_visits           Int?
  optimization_provider  String?              @default("HERE")
  optimization_status    String?              @default("pending")
  raw_response_json      Json?
  created_at             DateTime             @default(now())

  cycle                  RouteCycle?          @relation(fields: [route_cycle_id], references: [id], onDelete: Cascade)
  week                   RouteCycleWeek?      @relation(fields: [week_id], references: [id], onDelete: Cascade)
  supervisor             User                 @relation(fields: [supervisor_user_id], references: [id])
  items                  RouteSequenceItem[]
  executionLogs          RouteExecutionLog[]

  @@index([route_cycle_id])
  @@index([week_id])
  @@index([supervisor_user_id])
  @@map("route_sequences")
}

model RouteSequenceItem {
  id                             Int                 @id @default(autoincrement())
  route_sequence_id              Int
  sequence_number                Int
  client_snapshot_id             Int?
  client_id                      Int?
  city                           String?
  state                          String?
  classification                 String?
  stop_lat                       Float?
  stop_lng                       Float?
  distance_from_previous_km      Float?
  duration_from_previous_minutes Int?
  logistic_note                  String?
  is_week_start                  Boolean             @default(false)
  manually_changed               Boolean             @default(false)
  status                         String              @default("pendente") // pendente, agendada, em_rota, visitada, nao_visitada, remarcada, sem_sucesso, venda_feita

  sequence                       RouteSequence       @relation(fields: [route_sequence_id], references: [id], onDelete: Cascade)
  clientSnapshot                 RouteClientSnapshot? @relation(fields: [client_snapshot_id], references: [id])
  checkins                       VisitCheckin[]
  results                        VisitResult[]

  @@index([route_sequence_id])
  @@index([client_snapshot_id])
  @@map("route_sequence_items")
}

model RouteCluster {
  id                  Int            @id @default(autoincrement())
  route_cycle_id      Int
  supervisor_user_id  Int
  week_id             Int
  state               String?
  city                String?
  cluster_name        String?
  classification      String?
  total_clients       Int?
  average_distance_km Float?

  cycle               RouteCycle     @relation(fields: [route_cycle_id], references: [id], onDelete: Cascade)
  week                RouteCycleWeek @relation(fields: [week_id], references: [id], onDelete: Cascade)

  @@map("route_clusters")
}

model RouteBlock {
  id                 Int            @id @default(autoincrement())
  route_cycle_id     Int
  supervisor_user_id Int
  week_id            Int
  block_name         String?
  block_type         String?
  state              String?
  city               String?
  total_clients      Int?
  notes              String?

  cycle              RouteCycle     @relation(fields: [route_cycle_id], references: [id], onDelete: Cascade)
  week               RouteCycleWeek @relation(fields: [week_id], references: [id], onDelete: Cascade)

  @@map("route_blocks")
}

model RouteExecutionLog {
  id                Int           @id @default(autoincrement())
  route_sequence_id Int
  action            String
  action_by         Int
  payload_json      Json?
  created_at        DateTime      @default(now())

  sequence          RouteSequence @relation(fields: [route_sequence_id], references: [id], onDelete: Cascade)

  @@map("route_execution_logs")
}

model VisitCheckin {
  id                     Int               @id @default(autoincrement())
  route_sequence_item_id Int
  checkin_at             DateTime
  checkin_lat            Float?
  checkin_lng            Float?
  checkout_at            DateTime?
  checkout_lat           Float?
  checkout_lng           Float?
  checkin_source         String?
  notes                  String?

  sequenceItem           RouteSequenceItem @relation(fields: [route_sequence_item_id], references: [id], onDelete: Cascade)

  @@map("visit_checkins")
}

model VisitResult {
  id                     Int               @id @default(autoincrement())
  route_sequence_item_id Int
  result_status          String
  sale_made              Boolean           @default(false)
  sale_value             Float?
  notes                  String?
  registered_by          Int
  registered_at          DateTime          @default(now())

  sequenceItem           RouteSequenceItem @relation(fields: [route_sequence_item_id], references: [id], onDelete: Cascade)

  @@map("visit_results")
}

model RouteAuditLog {
  id          Int      @id @default(autoincrement())
  entity_name String
  entity_id   Int
  action      String
  old_data    Json?
  new_data    Json?
  changed_by  Int
  changed_at  DateTime @default(now())
  
  user        User     @relation(fields: [changed_by], references: [id])

  @@map("route_audit_logs")
}

model RouteExport {
  id             Int        @id @default(autoincrement())
  route_cycle_id Int
  export_type    String     // excel, pdf
  export_scope   String     // base_clientes, resumo_supervisores, roteiro_sequencial, resumo_roteiro, clusters, blocos, agenda, densidade
  filters_json   Json?
  generated_by   Int
  generated_at   DateTime   @default(now())
  file_url       String?
  file_name      String?

  cycle          RouteCycle @relation(fields: [route_cycle_id], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [generated_by], references: [id])

  @@map("route_exports")
}

model Group {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("groups")
}

model Module {
  id          String           @id
  name        String
  permissions UserPermission[]

  @@map("modules")
}

model UserPermission {
  userId   Int
  moduleId String
  canView  Boolean @default(false)
  canEdit  Boolean @default(false)
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("user_permissions")
}

model Territory {
  id        Int     @id @default(autoincrement())
  municipio String?
  uf        String?
  modo      String?
  userId    Int?
  user      User?   @relation("UserTerritories", fields: [userId], references: [id])

  @@map("territories")
}

model Bairro {
  id        Int     @id @default(autoincrement())
  bairro    String?
  regiao    String?
  municipio String?
  uf        String?
  modo      String?
  userId    Int?
  user      User?   @relation("UserBairros", fields: [userId], references: [id])

  @@map("bairros")
}

model PlanilhaConfig {
  id        Int      @id @default(autoincrement())
  tableName String
  fields    Json
}

model UserActivity {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activities")
}

model Cliente {
  id_cliente        Int                   @id @default(autoincrement())
  codigo_cliente    String?               @unique
  nome_cliente      String
  nome_abreviado    String?
  regiao            String?
  uf                String?
  cidade            String?
  bairro            String?
  cep               String?
  endereco_completo String?
  cnpj              String?
  latitude          Float?
  longitude         Float?
  status_ativo      Boolean               @default(true)
  data_cadastro     DateTime              @default(now())
  data_atualizacao  DateTime              @updatedAt
  semana            String?
  prioridade        String?
  numero            String?
  userId            Int?
  user              User?                 @relation("UserClientes", fields: [userId], references: [id])
  distancias        DistanciasLogistica[]
  historicos        HistoricoVisitas[]
  planejamentos     PlanejamentoVisitas[]

  @@index([userId])
  @@map("clientes")
}

model PlanejamentoVisitas {
  id_visita            Int       @id @default(autoincrement())
  id_cliente           Int
  id_supervisor        Int
  semana               String?
  data_visita_prevista DateTime?
  prioridade           String?
  status               String?   @default("Planejado")
  observacoes          String?
  cliente              Cliente   @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  supervisor           User      @relation(fields: [id_supervisor], references: [id], onDelete: Cascade)

  @@map("planejamento_visitas")
}

model DistanciasLogistica {
  id_distancia         Int      @id @default(autoincrement())
  id_cliente           Int
  id_supervisor        Int
  distancia_km         Float?
  modo_transporte      String?
  tempo_estimado_horas Float?
  data_calculo         DateTime @default(now())
  cliente              Cliente  @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  supervisor           User     @relation(fields: [id_supervisor], references: [id], onDelete: Cascade)

  @@map("distancias_logistica")
}

model BlocosViagem {
  id_bloco       Int       @id @default(autoincrement())
  codigo_bloco   String?   @unique
  id_supervisor  Int
  uf             String?
  semana         String?
  total_clientes Int?
  estrategicos   Int?
  km_estimado    Float?
  prioridade     String?
  data_criacao   DateTime?
  supervisor     User      @relation(fields: [id_supervisor], references: [id], onDelete: Cascade)

  @@map("blocos_viagem")
}

model ClustersCidades {
  id_cluster           Int      @id @default(autoincrement())
  uf                   String?
  cidade               String?
  tipo_cluster         String?
  total_clientes       Int?
  densidade            Float?
  supervisor_principal String?
  latitude             Float?
  longitude            Float?
  data_analise         DateTime @default(now())

  @@map("clusters_cidades")
}

model HistoricoVisitas {
  id_historico    Int       @id @default(autoincrement())
  id_cliente      Int
  id_supervisor   Int
  data_visita     DateTime?
  resultado       String?
  valor_negocio   Float?
  proximo_contato DateTime?
  observacoes     String?
  cliente         Cliente   @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  supervisor      User      @relation(fields: [id_supervisor], references: [id], onDelete: Cascade)

  @@map("historico_visitas")
}

model ConfigSistema {
  id_config        Int      @id @default(autoincrement())
  parametro        String   @unique
  valor            String?
  descricao        String?
  data_atualizacao DateTime @updatedAt

  @@map("config_sistema")
}

model FeedPost {
  id        Int            @id @default(autoincrement())
  userId    Int
  content   String
  image     String?
  sticker   String?
  createdAt DateTime       @default(now())
  comments  FeedComment[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions FeedReaction[]

  @@map("feed_posts")
}

model FeedComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String
  sticker   String?
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feed_comments")
}

model FeedReaction {
  id     Int      @id @default(autoincrement())
  postId Int
  userId Int
  emoji  String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@map("feed_reactions")
}

model Notification {
  id            Int                @id @default(autoincrement())
  title         String
  message       String
  createdAt     DateTime           @default(now())
  targetAll     Boolean            @default(true)
  targetUserIds Json?
  senderName    String?            @default("Sistema")
  seenByUsers   NotificationSeen[]

  @@map("notifications")
}

model NotificationSeen {
  id             Int          @id @default(autoincrement())
  notificationId Int
  userId         Int
  seenAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("notification_seen")
}

model UserType {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  color           String   @default("#3b82f6")
  showInMenu      Boolean  @default(false)
  createdAt       DateTime @default(now())
  active          Boolean  @default(true)
  isSystemDefault Boolean  @default(false)
  updatedAt       DateTime @default(now()) @updatedAt
  isAdmin         Boolean  @default(false)
  canVisit        Boolean  @default(false)
  icon            String   @default("User")
  users           User[]

  @@map("user_types")
}

// ═══════════════════════════════════════════════════════════════════
// DATA INTEGRATION MODULE
// ═══════════════════════════════════════════════════════════════════

model ExternalConnection {
  id                Int                  @id @default(autoincrement())
  name              String
  description       String?
  sourceType        String               @default("parquet") // parquet, parquet_folder, xlsx, postgresql, sqlserver, rest_api, s3, directory
  filePath          String?
  filePattern       String?
  optionsJson       Json                 @default("{}")
  datasetTarget     String?
  tags              Json                 @default("[]")
  status            String               @default("inactive") // active, inactive, error, testing
  lastValidatedAt   DateTime?
  lastRunAt         DateTime?
  lastPublishedAt   DateTime?
  lastError         String?
  validationResult  Json?
  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  creator           User                 @relation("ConnectionCreator", fields: [createdBy], references: [id])
  updater           User?                @relation("ConnectionUpdater", fields: [updatedBy], references: [id])
  datasets          ExternalDataset[]
  jobs              EtlJob[]
  runReferences     EtlJobRun[]          @relation("RunConnection")

  @@index([status])
  @@index([sourceType])
  @@index([createdBy])
  @@map("external_connections")
}

model ExternalDataset {
  id               Int                      @id @default(autoincrement())
  connectionId     Int
  name             String
  description      String?
  internalSchema   Json                     @default("{}")
  sourceSchema     Json?
  columnMapping    Json                     @default("[]")
  validationRules  Json                     @default("[]")
  rowCountEstimate Int?
  status           String                   @default("draft") // draft, validated, staged, published, error
  version          Int                      @default(1)
  createdBy        Int
  updatedBy        Int?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  connection       ExternalConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  creator          User                     @relation("DatasetCreator", fields: [createdBy], references: [id])
  updater          User?                    @relation("DatasetUpdater", fields: [updatedBy], references: [id])
  columns          ExternalDatasetColumn[]
  rules            ExternalDatasetRule[]
  jobs             EtlJob[]
  snapshots        ClientesSnapshot[]
  runReferences    EtlJobRun[]          @relation("RunDataset")

  @@index([connectionId])
  @@index([status])
  @@map("external_datasets")
}

model ExternalDatasetColumn {
  id               Int                @id @default(autoincrement())
  datasetId        Int
  sourceColumn     String
  targetField      String
  inferredType     String?
  targetType       String             @default("string") // string, integer, float, boolean, date, datetime, json
  isRequired       Boolean            @default(false)
  isKey            Boolean            @default(false)
  defaultValue     String?
  transformRule    String?
  transformOptions Json               @default("{}")
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  dataset          ExternalDataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("external_dataset_columns")
}

model ExternalDatasetRule {
  id              Int              @id @default(autoincrement())
  datasetId       Int
  field           String
  ruleType        String           // required, unique, uf_valid, cep_valid, email_valid, cnpj_valid, lat_valid, lng_valid
  severity        String           @default("error") // error, warning
  paramsJson      Json             @default("{}")
  errorMessage    String?
  isBlocking      Boolean          @default(true)
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now())

  dataset         ExternalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("external_dataset_rules")
}

model EtlJob {
  id               Int            @id @default(autoincrement())
  connectionId     Int
  datasetId        Int?
  name             String
  description      String?
  cronExpression   String?
  configJson       Json           @default("{}")
  mode             String         @default("full") // full, incremental
  maxErrors        Int            @default(100)
  status           String         @default("inactive") // active, inactive, error, running
  lastRunId        Int?
  lastRunStatus    String?
  lastRunAt        DateTime?
  createdBy        Int
  updatedBy        Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  connection       ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  dataset          ExternalDataset?   @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  creator          User               @relation("JobCreator", fields: [createdBy], references: [id])
  updater          User?              @relation("JobUpdater", fields: [updatedBy], references: [id])
  runs             EtlJobRun[]

  @@index([connectionId])
  @@index([status])
  @@map("etl_jobs")
}

model EtlJobRun {
  id               Int               @id @default(autoincrement())
  jobId            Int
  connectionId     Int
  datasetId        Int?
  runType          String            @default("manual") // manual, scheduled, retry, test
  status           String            @default("pending") // pending, testing, reading, inspecting, previewing, mapping, validating, staging, comparing, ready, published, failed, cancelled
  currentStep      String?
  progressPct      Int               @default(0)
  rowsRead         Int               @default(0)
  rowsValid        Int               @default(0)
  rowsInvalid      Int               @default(0)
  rowsDiscarded    Int               @default(0)
  rowsDeduplicated Int               @default(0)
  rowsNew          Int               @default(0)
  rowsChanged      Int               @default(0)
  rowsRemoved      Int               @default(0)
  errorCount       Int               @default(0)
  warningCount     Int               @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  errorMessage     String?
  resultJson       Json?
  triggeredBy      Int
  createdAt        DateTime          @default(now())

  job              EtlJob                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  connection       ExternalConnection    @relation("RunConnection", fields: [connectionId], references: [id], onDelete: Cascade)
  dataset          ExternalDataset?      @relation("RunDataset", fields: [datasetId], references: [id], onDelete: SetNull)
  triggerer        User                  @relation("RunTriggerer", fields: [triggeredBy], references: [id])
  steps            EtlJobRunStep[]
  logs             EtlRunLog[]
  snapshots        ClientesSnapshot[]

  @@index([jobId])
  @@index([status])
  @@index([triggeredBy])
  @@index([startedAt])
  @@map("etl_job_runs")
}

model EtlJobRunStep {
  id             Int          @id @default(autoincrement())
  runId          Int
  stepName       String       // test_access, read_source, inspect_schema, preview, validate, stage, compare, publish
  status         String       @default("pending") // pending, running, completed, failed, skipped
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  resultJson     Json?
  errorMessage   String?

  run            EtlJobRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  logs           EtlRunLog[]

  @@index([runId])
  @@map("etl_job_run_steps")
}

model EtlRunLog {
  id             Int              @id @default(autoincrement())
  runId          Int
  stepId         Int?
  level          String           @default("info") // debug, info, warn, error
  message        String
  detailsJson    Json?
  createdAt      DateTime         @default(now())

  run            EtlJobRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  step           EtlJobRunStep?   @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([stepId])
  @@index([level])
  @@map("etl_run_logs")
}

model ClientesSnapshot {
  id                Int                      @id @default(autoincrement())
  etlRunId          Int?
  datasetId         Int?
  versionLabel       String
  sourceDescription  String?
  totalRows         Int                      @default(0)
  validRows         Int                      @default(0)
  invalidRows       Int                      @default(0)
  duplicatesRemoved  Int                      @default(0)
  newClients        Int                      @default(0)
  changedClients    Int                      @default(0)
  removedClients    Int                      @default(0)
  status            String                   @default("staged") // staged, approved, published, rolled_back, cancelled
  createdBy         Int
  createdAt         DateTime                 @default(now())
  publishedAt       DateTime?

  etlRun            EtlJobRun?               @relation(fields: [etlRunId], references: [id], onDelete: SetNull)
  dataset           ExternalDataset?         @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  creator           User                     @relation("SnapshotCreator", fields: [createdBy], references: [id])
  items             ClientesSnapshotItem[]
  publishedVersions ClientesPublishedVersion[]

  @@index([status])
  @@index([etlRunId])
  @@map("clientes_snapshots")
}

model ClientesSnapshotItem {
  id                Int                   @id @default(autoincrement())
  snapshotId        Int
  codigoCliente     String
  nomeCliente       String
  nomeAbreviado     String?
  regiao            String?
  uf                String?
  cidade            String?
  bairro            String?
  cep               String?
  enderecoCompleto  String?
  numero            String?
  cnpj              String?
  documento         String?
  telefone          String?
  email             String?
  latitude          Float?
  longitude         Float?
  vendedor          String?
  representante     String?
  status            String?                @default("ativo")
  segmento          String?
  canal             String?
  dataCadastro      DateTime?
  dataUltimaCompra  DateTime?
  limiteCredito     Float?
  faturamento       Float?
  observacoes       String?
  changeType        String?                // new, changed, removed, unchanged, invalid
  changeDetails     Json?
  isValid           Boolean                @default(true)
  validationErrors  Json                   @default("[]")
  isActive          Boolean                @default(true)
  sourceRawJson     Json?
  createdAt         DateTime               @default(now())

  snapshot          ClientesSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([codigoCliente])
  @@index([changeType])
  @@index([isValid])
  @@map("clientes_snapshot_items")
}

model ClientesPublishedVersion {
  id               Int                   @id @default(autoincrement())
  snapshotId       Int
  versionNumber    Int
  versionLabel     String
  isActive         Boolean               @default(false)
  totalClients     Int                   @default(0)
  newClients       Int                   @default(0)
  changedClients   Int                   @default(0)
  removedClients   Int                   @default(0)
  publishedBy      Int
  publishedAt      DateTime              @default(now())
  rolledBackAt     DateTime?
  rolledBackBy     Int?
  rollbackReason   String?
  metadataJson     Json                  @default("{}")

  snapshot         ClientesSnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  publisher        User                      @relation("VersionPublisher", fields: [publishedBy], references: [id])
  rollbacker       User?                     @relation("VersionRollbacker", fields: [rolledBackBy], references: [id])
  overrides        ClientesSourceOverride[]

  @@index([versionNumber])
  @@index([snapshotId])
  @@map("clientes_published_versions")
}

model ClientesSourceOverride {
  id                Int                      @id @default(autoincrement())
  codigoCliente     String
  fieldName         String
  originalValue     String?
  overriddenValue   String
  overrideReason    String?
  appliedInVersion  Int?
  createdBy         Int
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  version           ClientesPublishedVersion? @relation(fields: [appliedInVersion], references: [id], onDelete: SetNull)
  creator           User                      @relation("OverrideCreator", fields: [createdBy], references: [id])

  @@unique([codigoCliente, fieldName])
  @@index([codigoCliente])
  @@index([appliedInVersion])
  @@map("clientes_source_overrides")
}
